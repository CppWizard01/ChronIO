# ==============================================================================
# ChronIO — Environment Configuration Template (.env.example)
# Copy to .env for local overrides: cp .env.example .env
# ==============================================================================

# Target Process & Tiny Tapeout Parameters
CHRONIO_PDK=ihp-sg13cmos5l
CHRONIO_TILES=8x4
CHRONIO_TOP_MODULE=tt_um_chronio
CHRONIO_CLOCK_HZ=60000000

# Architecture Generator Parameters (Hardcaml & Python Golden ISS)
CHRONIO_NUM_LANES=4
CHRONIO_IMEM_WORDS=1024
CHRONIO_DMEM_WORDS=64
CHRONIO_FIFO_DEPTH=4

# Default RTL Simulator for cocotb (icarus or verilator)
SIM=icarus

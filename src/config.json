{
  "//": "ChronIO - LibreLane Configuration for Tiny Tapeout IHP SG13CMOS5L (8x4 Tiles + 1024x32 SRAM Macro)",

  "PL_TARGET_DENSITY_PCT": 60,
  "CLOCK_PERIOD": 16.67,
  "PL_RESIZER_HOLD_SLACK_MARGIN": 0.1,
  "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.05,
  "RUN_LINTER": 1,
  "LINTER_INCLUDE_PDK_MODELS": 1,
  "CLOCK_PORT": "clk",

  "//": "======== IHP 1024x32 (4KB) SRAM macro (RM_IHPSG13_1P_1024x32_c2_bm_bist) ========",

  "//": "Insert the Project.ExtendPowerStripes step (librelane_plugin_sram_pdn.py) after the PDN generator.",
  "meta": {
    "flow": "Classic",
    "substituting_steps": { "+OpenROAD.GeneratePDN": "Project.ExtendPowerStripes" }
  },

  "//": "The instance sits at the bottom left, flipped (FS) so that its pins (on its bottom edge) face up",
  "//": "towards the logic. x = 3.36 puts the macro's power columns right under the PDN stripes.",
  "MACROS": {
    "RM_IHPSG13_1P_1024x32_c2_bm_bist": {
      "instances": {
        "sram": { "location": [3.36, 3.78], "orientation": "FS" }
      },
      "gds": ["pdk_dir::libs.ref/sg13cmos5l_sram/gds/RM_IHPSG13_1P_1024x32_c2_bm_bist.gds"],
      "lef": ["pdk_dir::libs.ref/sg13cmos5l_sram/lef/RM_IHPSG13_1P_1024x32_c2_bm_bist.lef"],
      "lib": {
        "*_typ_*": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_1024x32_c2_bm_bist_typ_1p20V_25C.lib"],
        "*_fast_*": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_1024x32_c2_bm_bist_fast_1p32V_m55C.lib"],
        "*_slow_*": ["pdk_dir::libs.ref/sg13cmos5l_sram/lib/RM_IHPSG13_1P_1024x32_c2_bm_bist_slow_1p08V_125C.lib"]
      }
    }
  },

  "//": "The SRAM has two supply rails (VDD!, VDDARRAY!) and one ground rail (VSS!).",
  "PDN_MACRO_CONNECTIONS": [
    "sram VPWR VGND VDD! VSS!",
    "sram VPWR VGND VDDARRAY! VSS!"
  ],

  "//": "PDN: Skip connecting the SRAM by pdngen; it is powered by ExtendPowerStripes instead.",
  "PDN_CFG": "dir::pdn_cfg.tcl",
  "EXTEND_STRIPES_SRAM_ARRAY_EVERY_OTHER": true,
  "ERROR_ON_PDN_VIOLATIONS": 0,
  "RUN_MAGIC_DRC": 0,
  "ERROR_ON_ILLEGAL_OVERLAPS": 0,

  "//": "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",
  "//": "!!! DO NOT CHANGE ANYTHING BELOW THIS POINT !!!",
  "//": "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",

  "RUN_KLAYOUT_XOR": 0,
  "RUN_KLAYOUT_DRC": 0,
  "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS": 0,
  "TOP_MARGIN_MULT": 1,
  "BOTTOM_MARGIN_MULT": 1,
  "LEFT_MARGIN_MULT": 6,
  "RIGHT_MARGIN_MULT": 6,
  "FP_SIZING": "absolute",
  "GRT_ALLOW_CONGESTION": 1,
  "FP_IO_HLENGTH": 2,
  "FP_IO_VLENGTH": 2,

  "//": "PDN stripes matched to the SRAM's Metal4 power columns: 44.96 = 4 x 11.24 um column pitch,",
  "//": "2.1 + 3.52 = 5.62 um from VPWR to VGND as in the macro, first VPWR stripe centred at 9.03 um.",
  "FP_PDN_VPITCH": 44.96,
  "FP_PDN_VWIDTH": 2.1,
  "FP_PDN_VSPACING": 3.52,
  "FP_PDN_VOFFSET": 6.15,

  "RUN_CTS": 1,
  "FP_PDN_MULTILAYER": 0,
  "MAGIC_DEF_LABELS": 0,
  "MAGIC_WRITE_LEF_PINONLY": 1
}
